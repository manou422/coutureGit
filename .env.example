# Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par Git : il ne doit JAMAIS être publié.

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=album

# --- Sécurité des sessions ---
# Chaîne aléatoire longue. En générer une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La changer invalide toutes les sessions en cours.
SESSION_SECRET=

# --- Compte administrateur ---
# Utilisés uniquement au tout premier démarrage, si aucun admin n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=
ADMIN_PRENOM=

# Port d'écoute (imposé par l'hébergeur en production)
PORT=3000

# --- Code d'invitation ---
# Si defini, l'inscription exige ce code. Laisser vide = inscription libre.
INVITATION_CODE=

# --- Envoi d'emails (reinitialisation de mot de passe) ---
# Sans SMTP_HOST, la fonction « mot de passe oublie » est desactivee.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Adresse publique du site, utilisee dans le lien de reinitialisation.
SITE_URL=
